# ─── Dominio ───
DOMAIN=xama-ong.org

# ─── PostgreSQL ───
POSTGRES_USER=xama_user
POSTGRES_PASSWORD=CAMBIA_ESTO_password_fuerte_aleatoria
POSTGRES_DB=xama_db

# ─── JWT ───
# Genera con: openssl rand -hex 32
SECRET_KEY=CAMBIA_ESTO_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── CORS ───
# En single-domain, el frontend llama al mismo origen → no hace falta CORS real
# Solo dejamos el dev por si acaso
CORS_ORIGINS=https://xama-ong.org
